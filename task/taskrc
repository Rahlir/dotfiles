# TASKRC - Task System v3
#
# Minimal by design: the AI (pi / chatbot) is the primary interface and
# does ranking, reviews, and reports. This config only keeps raw `task`
# feasible without AI. Config is FROZEN: changes only in a quarterly
# design session. See projects/task-system-v3.md in the notes repo.
#
# by Tadeas Uhlir <tadeas.uhlir@gmail.com>

### Includes ###
# Color theme
include themes/$THEMENAME-$THEMEBG.theme
# Sync config (sensitive and device dependent, not in dotfiles)
include $XDG_CONFIG_HOME/task/tasksyncrc

### XDG dirs ###
data.location=$XDG_DATA_HOME/task
hooks.location=$XDG_CONFIG_HOME/task/hooks

### Task model ###
# +active = this week's working set (managed at weekly refresh).
# Backlog = pending without +active. The boost keeps stock reports
# (next) useful without AI.
urgency.user.tag.active.coefficient=15.0

### Reports ###
# This week's working set
report.week.description=This week's working set
report.week.filter=status:pending +active
report.week.columns=id,project,priority,due.relative,description.count,urgency
report.week.labels=ID,Project,Prio,Due,Description,Urg
report.week.sort=urgency-

# Backlog, oldest first (doubles as a manual decay view)
report.shelf.description=Backlog (pending, not active)
report.shelf.filter=status:pending -active
report.shelf.columns=id,entry.age,project,due.relative,description.count
report.shelf.labels=ID,Age,Project,Due,Description
report.shelf.sort=entry+

# Bare `task` shows the week
default.command=week

### Other ###
# Weekly refresh happens on Monday
weekstart=Monday
news.version=3.4.2
